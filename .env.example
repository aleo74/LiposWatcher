# Copiez ce fichier vers .env avant docker compose up.
COOKIE_SECURE=true
BIND_ADDRESS=127.0.0.1
PORT=8000
# Adresse(s) IP/CIDR du seul reverse proxy autorisé à fournir X-Forwarded-*.
# Adapter à l'adresse vue depuis le conteneur ; ne pas utiliser * sur un port exposé.
FORWARDED_ALLOW_IPS=127.0.0.1
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=900

# Courrier requis pour inscription, récupération et invitations.
APP_ENV=production
PUBLIC_REGISTRATION=true
PUBLIC_URL=https://batteries.example.org
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
AUTH_REQUEST_MAX=8
AUTH_REQUEST_WINDOW=900
VERIFY_TOKEN_MINUTES=60
RESET_TOKEN_MINUTES=60
TRANSFER_HOURS=72

# PostgreSQL uniquement. URL psycopg ; encoder les caractères réservés du mot de passe.
DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
WEB_CONCURRENCY=2
