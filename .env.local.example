# HTTP local uniquement. Copier vers .env pour Docker Compose.
COOKIE_SECURE=false
BIND_ADDRESS=127.0.0.1
PORT=8000
FORWARDED_ALLOW_IPS=127.0.0.1
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=900

# Courrier requis pour inscription, récupération et invitations.
APP_ENV=local
PUBLIC_REGISTRATION=true
PUBLIC_URL=http://127.0.0.1:8000
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
AUTH_REQUEST_MAX=8
AUTH_REQUEST_WINDOW=900
VERIFY_TOKEN_MINUTES=60
RESET_TOKEN_MINUTES=60
TRANSFER_HOURS=72

# PostgreSQL uniquement. URL psycopg ; encoder les caractères réservés du mot de passe.
DATABASE_URL=postgresql+psycopg://lipowatcher:local_change_me@postgres:5432/lipowatcher
POSTGRES_USER=lipowatcher
POSTGRES_DB=lipowatcher
POSTGRES_PASSWORD=local_change_me
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
WEB_CONCURRENCY=2

# Base séparée, créée explicitement pour la recette automatisée.
TEST_DATABASE_URL=postgresql+psycopg://lipowatcher:local_change_me@postgres:5432/lipowatcher_test
